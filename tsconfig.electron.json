{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "outDir": "./dist-electron",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "types": ["node"]
  },
  "include": [
    "electron/**/*.ts",
    "src/types/institute.ts",
    "src/data/seedData.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-electron"]
}
